/**
 * Types for `scripts/mitra-program.mjs`.
 *
 * The implementation is a `.mjs` harness module and the project's `tsconfig` does
 * not type-check JavaScript, so without this the TypeScript that *pins* those bytes
 * (`tests/dev-scripts.test.ts`) would be asserting against `any` — the test would
 * still fail on a wrong value, but it would give no help finding a wrong shape.
 *
 * Deliberately narrow. The **values** are pinned to Rust-generated bytes by
 * `tests/dev-scripts.test.ts`; this file only describes shapes, so there are two
 * things to keep in step rather than three. The `PublicKey` constructor is passed in
 * rather than imported so this declaration needs no dependency of its own.
 */
import type { PublicKey } from "@solana/web3.js";

export const VAULT_PROGRAM_ID: string;

export const account: {
  vault: Buffer;
  mandate: Buffer;
  authorization: Buffer;
  jobEscrow: Buffer;
};

export const IX: {
  initializeVault: Buffer;
  deposit: Buffer;
  openMandate: Buffer;
  authorize: Buffer;
  spendAuthorized: Buffer;
  amendMandate: Buffer;
  lockEscrow: Buffer;
  releaseEscrow: Buffer;
  refundEscrow: Buffer;
};

export const VAULT_LEN: number;
export const MANDATE_LEN: number;
export const AUTHORIZATION_LEN: number;
export const ESCROW_LEN: number;

export const ERRORS: Record<number, string>;

/** `[b"vault", principal]` */
export const vaultPda: (
  principal: PublicKey,
  programId: PublicKey,
  PublicKeyCtor: typeof PublicKey,
) => [PublicKey, number];

/** `[b"escrow", vault, job_id]` — the job id must be 32 bytes. */
export const escrowPda: (
  vault: PublicKey,
  jobId: Uint8Array,
  programId: PublicKey,
  PublicKeyCtor: typeof PublicKey,
) => [PublicKey, number];

/** PRD §15.5 — domain-separated sha256 of a route description. */
export const routeHashFor: (route: string) => Buffer;
