# Dependencies
node_modules

# Next.js build output
.next
out
build

# Environment files (never commit real secrets)
.env
.env.*
!.env.example

# Test coverage
coverage

# OS metadata
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Shared context: the local sqlite log is machine-specific and must NOT be
# committed. The sync/ folder below is separate and IS committed — that is how
# context reaches collaborators on other machines.
.shared-context/

# Editor/IDE
.vscode
.idea

# TypeScript incremental build info
*.tsbuildinfo

# Shared context memory (local sqlite log; share via sync bundles, not git)

# Development keypairs — testnet secrets, never commit
.dev-keys/

# Rust / Solana program build output. The .so and the generated program keypair
# are build artifacts — the keypair especially: it is a *program* key, and a
# program key committed to git is a program anyone can upgrade.
programs/*/target/
programs/*/Cargo.lock

# `solana-test-validator` writes its ledger here, including a *faucet keypair*.
# A testnet faucet key is not high value, but it is exactly the habit this repo's
# secrets tests exist to prevent, and the directory is 32MB of RocksDB besides.
test-ledger/
.dev-logs/
