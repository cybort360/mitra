{
  "name": "mitra-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "vitest run --no-file-parallelism",
    "test:all": "npm test && npm run test:postgres",
    "test:watch": "vitest",
    "mcp": "tsx scripts/mitra-mcp.ts",
    "contracts:setup": "cd contracts && forge install foundry-rs/forge-std --no-git",
    "contracts:test": "cd contracts && forge test",
    "verify:saga-events": "node scripts/verify-showcase-events.mjs",
    "showcase:saga": "node scripts/showcase-live-saga.mjs",
    "mitra-mcp": "tsx scripts/mitra-mcp.ts",
    "sandbox": "tsx scripts/sandbox.ts",
    "agents:run": "tsx scripts/run-autonomous-agents.ts",
    "stack:up": "tsx scripts/stack.ts up",
    "stack:status": "tsx scripts/stack.ts status",
    "stack:down": "tsx scripts/stack.ts down",
    "mcp:daemon": "tsx scripts/mcp-server-daemon.ts",
    "keeper:once": "tsx scripts/keeper-daemon.ts --once",
    "showcase:full": "tsx scripts/showcase-agents.ts",
    "showcase:agents": "tsx scripts/showcase-agents.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "lucide-react": "1.48.0",
    "next": "16.3.7",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@solana/web3.js": "^1.99.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "bs58": "^6.0.0",
    "js-sha3": "^0.13.0",
    "tsx": "^4.23.15",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.9.2",
    "viem": "^2.57.2",
    "vitest": "^3.2.4"
  }
}
