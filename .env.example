# Mitra 0.1 — environment template
#
# The current LOCAL_PASS build consumes NO environment variables. It runs
# entirely on the in-repo deterministic seed store and unconfigured adapters.
#
# The variables below are placeholders for the production integration path
# described in README.md and docs/ARCHITECTURE.md. They are DESIGN_ONLY today.
# Copy this file to `.env.local` and fill in real values ONLY when the
# corresponding adapter is actually wired. Never commit real secrets.

# --- Datastore (production: Postgres + durable event log) ---
DATABASE_URL=

# --- Settlement rails (lib/settlement/rails.ts) — TESTNETS ONLY ---
# A rail is built only when ALL of its variables are set; otherwise
# POST /api/v1/settlements answers 503 SETTLEMENT_RAIL_NOT_CONFIGURED and nothing
# is claimed or consumed. There is no fallback transport.
#
# Base Sepolia (84532) and Tempo Moderato share one relayer key (seq 55):
MITRA_EVM_SETTLEMENT_KEY_FILE=
BASE_RPC_URL=
# eoa (default): the key's own address pays. erc4337: a Coinbase Smart Wallet owned
# by the key pays, via UserOperations the key submits to EntryPoint v0.6. The vault
# record's address must be the payer either way (VAULT_NOT_BOUND_TO_RAIL).
MITRA_BASE_SETTLEMENT_ACCOUNT=
TEMPO_RPC_URL=
# Solana devnet, through mitra-vault. The engine key must be the mandate's named
# policy engine; the vault must be the PDA of the principal that granted it.
SOLANA_RPC_URL=
MITRA_SOLANA_ENGINE_KEY_FILE=
MITRA_SOLANA_HOLDER=
MITRA_SOLANA_VAULT=

# --- Marketplace / protocol integrations ---
MARKETPLACE_API_KEY=
X402_FACILITATOR_URL=
MPP_PROVIDER_URL=

# --- Phase 3: durable store ---
# Required. There is deliberately no default: silently falling back would let a
# run appear to pass against developer state that does not exist in production.
DATABASE_URL=
DATABASE_POOL_MAX=10
